# Dev-only values. Real environments inject these from the secret store.
# Runtime connection: app_rw (no UPDATE/DELETE on audit_log).
DATABASE_URL=postgresql://app_rw:app_rw_dev@localhost:5432/internal_template
# Migrations/reset run as the schema owner.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internal_template
SESSION_SECRET=dev-only-session-secret-not-for-prod-000000
AUTH_PROVIDER=mock
